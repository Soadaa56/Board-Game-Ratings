<div id="<%= dom_id post %>">
  <p>
    <%= link_to (post.title.capitalize), post_path(post.id) %>
  </p>
  <p>
    <strong>Posted by: </strong>
    <%= post.user.name.capitalize %>
  </p>

  <p>
    <strong>Description: </strong>
    <%= post.body %>
  </p>

  <p>
    <strong>User Average Score:</strong>
  </p>

  <p>
    <strong>Admin average Score:</strong>
  </p>

  <p>
    <strong>BGG Rating:</strong>
  </p>
</div>
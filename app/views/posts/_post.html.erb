<div id="<%= dom_id post %>">
  <p class="fs-1" style="text-decoration: underline">
    <strong><%= post.title.capitalize %></strong>
  </p>
  <p>
    <strong>Posted by: </strong>
    <%= post.user.name.capitalize %>
  </p>

  <p>
    <strong>Description: </strong>
    <%= post.body %>
  </p>

  <p>
    <strong>
      <% if post.average_user_score == nil %>
        User Average Rating: ?
      <% else %>
        User Average Rating: <%= post.average_user_score %>
      <% end %>
    </strong>
  </p>

  <p>
    <strong>Admin average Rating: <%= post.average_admin_score %></strong>
  </p>

  <p>
    <strong>BGG Rating:</strong>
  </p>
</div>
<div id="<%= dom_id post %>">
  <p class="fs-1" style="text-decoration: underline">
    <strong><%= link_to "#{post.title.capitalize}", post_path(post) %></strong>
  </p>
  <p>
    <strong>Description: </strong>
    <% if post_body_length < 500 %>
      <%= raw post.body.truncate(post_body_length, separator: ' ', omission: '... (expand)') %>
    <% else %>
      <%= raw post.body %>
    <% end %>
  </p>
  <p>
    <strong>Posted by: </strong>
    <%= post.user.name.capitalize %>
  </p>
  <p>
    <% if post.average_user_score == nil %>
      <strong>User Average Rating: </strong>?
    <% else %>
      <strong>User Average Rating: </strong><%= post.average_user_score %>
    <% end %>
  </p>
  <p>
    <% if post.average_admin_score == nil %>
      <strong>Admin Average Rating: </strong>?
    <% else %>
      <strong>Admin Average Rating: </strong><%= post.average_admin_score %>
    <% end %>
  </p>
  <p>
    <% if post.average_user_score != nil && post.average_admin_score != nil %>
      <strong>Average Site Score: </strong><%= post.combined_average_score %>
    <% end %>
  </p>
  <p>
    <% if post.bgg_rating == nil%>
      <strong>BGG Rating: </strong>?
    <% else %>
      <strong>Bgg Rating: </strong><%= post.bgg_rating %>
    <% end %>
  </p>
</div>
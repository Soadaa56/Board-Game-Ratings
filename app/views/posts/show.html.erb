<p style="color: green"><%= notice %></p>

<div class="container">
  <%= render @post %>
  
  <div>
    <%= link_to "Edit this post", edit_post_path(@post), class: "btn btn-outline-secondary" %> 
    <br/><br/><br/>
    <%= button_to "Destroy this post", @post, method: :delete, class: "btn btn-outline-danger" %>
    <br/><br/><br/>
    <%= button_to "Back", :back, class: "btn btn-outline-primary" %>
  </div>
</div>

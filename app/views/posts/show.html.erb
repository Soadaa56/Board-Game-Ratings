<p style="color: green"><%= notice %></p>

<div class="container">
  <div>
    <%= link_to "Back", posts_path, class: "btn btn-outline-primary" %>
  </div>
  <div class="row align-items-start">
    <div class="col">
      <%= render @post %>
      <%= render "ratings/user_ratings" %>
      </div>
    <div class="col">
      <% if @post.image_pin%>
        <%= image_tag @post.image_pin, size: "400x400" %>
      <% end %>
      </div>
  </div>

  <br><br>
  <% if current_user.admin? %>
    <div>
      <%= link_to "Edit this post", edit_post_path(@post), class: "btn btn-outline-secondary" %>
      <br/><br/><br/>
      <%= button_to "Destroy this post", @post, method: :delete, class: "btn btn-outline-danger" %>
      <br/><br/>
    </div>
  <% end %>
  <div>
    <%= link_to "Back", posts_path, class: "btn btn-outline-primary" %>
  </div>
</div>
<p style="color: green"><%= notice %></p>

<div class="container">
  <div>
    <%= link_to "Back", posts_path, class: "btn btn-outline-primary" %>
  </div>
  <div class="row align-items-start">
    <div class="col">
      <%# compromise to truncate post on posts/index but not affect posts/show %>
      <%= render @post, post_body_length: 5000 %>
      <%= render "ratings/user_ratings" %>
      </div>
    <div class="col game-image">
      <% if @post.image_pin%>
        <%= image_tag @post.image_pin, size: "400x400" %>
      <% end %>
    </div>
  </div>

  <br><br>
  <% if current_user.admin? %>
    <div>
      <%= link_to "Edit this post", edit_post_path(@post), class: "btn btn-outline-secondary" %>
      <br/><br/><br/>
      <%= link_to 'Destroy', posts_path, method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: "btn btn-outline-danger" %>
      <br/><br/>
    </div>
  <% end %>
  <div>
    <%= link_to "Back", posts_path, class: "btn btn-outline-primary" %>
  </div>
</div>
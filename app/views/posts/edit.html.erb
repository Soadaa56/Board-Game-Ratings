<div class="container">
  <h1>Editing post</h1>

  <div class="container">
    <div class="row">
      <div class="col">
        <%= render "form", post: @post %>
      </div>
      <div class="col">
        <%= image_tag @post.thumbnail %>
      </div>
    </div>
  
    <%#= @post.pins %>
  </div>
  <br/><br/><br/>
  <div>
    <%= link_to "Show this post", @post %> |
    <%= link_to "Back to posts", posts_path %>
  </div>
</div>

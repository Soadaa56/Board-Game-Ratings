<div class="container">
  <div>
    <%= link_to "Back to posts", posts_path %>
  </div>

  <% if current_user %>
    <h1>Add Board Game</h1>
    <div class="row align-items-start">
      <div class="col">
        <%= render "form", post: @post %>
      </div>
      <div class="col">
        <div>
          <%= form_with url: fetch_board_games_posts_path, method: :get, data: { turbo: true }, id: "fetch_bgg_games" do %>
            <%= text_field_tag :query, nil, placeholder: "Search for board game" %>
            <%= submit_tag "Search"%>
          <% end %>
        </div>
        <div id="query_results">
        </div>
      </div>
    </div>
  <% else %>
    <p>Log in to add games!</p>
      <%= link_to "Sign Up", new_user_registration_path, class: "nav-link" %>
      <%= link_to "Sign In", new_user_session_path, class: "nav-link" %>
  <% end %>
</div>
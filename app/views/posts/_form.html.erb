<%= form_with(model: post, id: "new-post-form") do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <strong><%= form.label :title, style: "display: block" %></strong>
    <%= form.text_field :title %>
  </div>

  <div>
    <strong><%= form.label :description, style: "display: block" %></strong>
    <%= form.text_area :body %>
  </div>

  <div>
    <strong><%= form.label :bgg_id, "Board Game Geeks ID#", style: "display: block" %></strong>
    <%= form.number_field :bgg_id %>
  </div>

  <div>
    <%= form.fields_for :ratings do |rating_form| %>
      <%= render 'ratings/ratings_form', f: rating_form %>
    <% end %>
  </div>

  <div>
    <%= form.hidden_field :image_pin %>
  </div>

  <div>
    <%= form.hidden_field :thumbnail_url %>
  </div>
  

  <br/>

  <%= form.submit %>
<% end %>
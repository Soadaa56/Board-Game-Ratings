<div>
  <% if @results.present? %>
    <% @results.each do |result| %>
        <div class="game-item" data-game-id="<%= result[:game_id] %>" data-game-name="<%= result[:name] %>" %>
          <h6><%= result[:name] %> (<%= result[:year] %>)</h6>
          <p>ID: <%= result[:game_id] %></p>
        </div>
      <% end %>
  <% elsif @results.nil? %>
    <%# Display nothing on fresh page load %>
  <% else %>
    <p>No results found.</p>
  <% end %>
</div>

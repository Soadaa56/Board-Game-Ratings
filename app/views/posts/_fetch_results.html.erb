<div>
  <% if @results.present? %>
    <% @results.each do |result| %>
        <div class="game-item" data-controller="game-selector" data-game-selector-target="game"
          data-game-id="<%= result[:game_id] %>" data-game-name="<%= result[:name] %>" >
          
          <h6><%= result[:name] %> (<%= result[:year] %>)</h6>
          
          <div class="row align-items-start"  >
            <div class="col">
              <p>ID: <%= result[:game_id] %></p>
            </div>
            
            <div class="col"  data-action="click->game-selector#select" >
              <%= link_to "Select", nil, class: "btn btn-primary" %>
            </div>

          </div>
        </div>
      <% end %>
  <% elsif @results.nil? %>
    <%# Display nothing on fresh page load %>
  <% else %>
    <p>No results found.</p>
  <% end %>
</div>

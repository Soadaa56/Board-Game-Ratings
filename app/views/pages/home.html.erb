<div class="container">
  <h1>Home</h1>
  <% if current_user %>
    <p>Welcome, <%= current_user.name %>!</p>
    <p>Try adding some board games to rate. <%= link_to "Add Board Game", new_post_path %> </p>
  <% else %>
    <p>Welcome!</p>
    <p><%= link_to "Sign In", new_user_session_path %> or <%= link_to "Sign Up", new_user_registration_path %> to add or rate board games.</p>
  <% end %>
  <p>Come look at the rankings of our favorite board games. <%= link_to "Board Game Rankings", posts_path %> </p>
</div>


<div>
  <strong><%= f.label :score, "Rate This Game: ", class: "me-3" %></strong>
  <% (1..10).each do |i| %>
    <div class="form-check form-check-inline">
      <div class="form-check-input">
        <%= f.radio_button :score, i, id: "rating_#{i}" %>
      </div>
      <div class="form-check-label">
        <%= f.label "Rate_#{i}", i %>
      </div>
    </div>
  <% end %>
</div>
<br>
<%= f.submit "Submit Rating", class: "btn btn-outline-success" %>
<%= form_with(model: [@post, @pin] ) do |form| %>
  

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.rich_text_area :body %>
  </div>

  <div>
    <%= form.label :image %>
    <%= form.file_field :image %>
  </div>

  <div>
    <%= form.label :pictures %>
    <%= form.file_field :pictures, multiple: true%>
  </div>

  <div>
    <%= form.label :postid %>
    <%= form.number_field :post_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<h1 class="text-center">
  <%= pluralize(@posts.count, "Result") %>
</h1>

<div class="container">
  <table class="table table-dark table-striped">
    <thead>
      <tr>
        <th><%= sort_link(@query, :title, "Game", default_order: :asc) %></th>
        <th><%= sort_link(@query, :body, "Description") %></th>
        <th><%= sort_link(@query, :ratings, "Average Ratings") %></th>
        <th><%= sort_link(@query, :bgg_ratings, "BGG Rating") %></th>
      </tr>
    </thead>
    <tbody>
      <%= render "posts" %>
    </tbody>
  </table>
</div>
